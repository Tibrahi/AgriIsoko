# Neon Console → Project → Connect → Node.js connection string.
# Keep the URI exactly as Neon provides it and do not prefix it with NEXT_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require

# Optional one-time administrator creation settings.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=AgriIsoko Administrator
ADMIN_PASSWORD=replace-with-a-long-unique-password
